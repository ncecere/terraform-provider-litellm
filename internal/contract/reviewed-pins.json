  "categories": [
    {
      "disposition": "unsupported_durable",
      "id": "credential_inventory",
      "issue": "#248",
      "rationale": "Credential collection inventory is durable but its sensitivity, pagination, and ownership semantics require a separate resource decision."
    },
    {
      "disposition": "unsupported_durable",
      "id": "vector_store_management",
      "issue": "#249",
      "rationale": "Vector-store inventories and alternate durable CRUD surfaces require a separate identity and ownership decision."
    },
    {
      "disposition": "unsupported_durable",
      "id": "pass_through_configuration",
      "issue": "#251",
      "rationale": "Configured pass-through endpoint records can contain routing and secret-bearing data and need an explicit lifecycle design."
    },
    {
      "disposition": "unsupported_durable",
      "id": "policy_version_attachment_management",
      "issue": "#252",
      "rationale": "Policy records, versions, and many-to-many attachments require independent import, replacement, and drift semantics."
    },
    {
      "disposition": "unsupported_durable",
      "id": "mcp_toolset_management",
      "issue": "#207",
      "rationale": "MCP toolset records and assignments have identities distinct from supported MCP server lifecycle ownership."
    },
    {
      "disposition": "unsupported_durable",
      "id": "mcp_credential_configuration",
      "issue": "#207",
      "rationale": "Per-user MCP credentials and environment records are durable sensitive configuration with separate ownership semantics."
    },
    {
      "disposition": "unsupported_durable",
      "id": "mcp_server_management",
      "issue": "#207",
      "rationale": "MCP submission inventory is a durable management surface not covered by the supported server resource lifecycle."
    },
    {
      "disposition": "unsupported_durable",
      "id": "customer_end_user_management",
      "issue": "#207",
      "rationale": "Customer and end-user records overlap external identity systems and require explicit authority and import decisions."
    },
    {
      "disposition": "unsupported_durable",
      "id": "scim_directory_management",
      "issue": "#207",
      "rationale": "SCIM users and groups are synchronization records whose source of authority cannot be assumed by Terraform."
    },
    {
      "disposition": "unsupported_durable",
      "id": "global_proxy_configuration",
      "issue": "#207",
      "rationale": "Global proxy, integration, router, discount, and secret-backend settings have shared merge and restart semantics not modeled by current resources."
    },
    {
      "disposition": "unsupported_durable",
      "id": "integration_callback_configuration",
      "issue": "#207",
      "rationale": "Callback, email, plugin, and marketplace plugin configuration requires dedicated identity and sensitive-value lifecycle review."
    },
    {
      "disposition": "unsupported_durable",
      "id": "model_management",
      "issue": "#207",
      "rationale": "Alternate model and router management operations are not covered by the provider's reviewed model lifecycle."
    },
    {
      "disposition": "unsupported_durable",
      "id": "key_management",
      "issue": "#207",
      "rationale": "Alternate key aliases and key-management records require separate ownership and import semantics."
    },
    {
      "disposition": "unsupported_durable",
      "id": "team_management",
      "issue": "#207",
      "rationale": "Alternate team bulk and membership management operations are outside the supported resource lifecycle contract."
    },
    {
      "disposition": "unsupported_durable",
      "id": "organization_project_management",
      "issue": "#207",
      "rationale": "Alternate organization and project management operations require separate lifecycle and authority review."
    },
    {
      "disposition": "unsupported_durable",
      "id": "user_budget_management",
      "issue": "#207",
      "rationale": "Additional durable user, budget, tag, and allowlist configuration is not owned by current resource lifecycles."
    },
    {
      "disposition": "unsupported_durable",
      "id": "access_control_management",
      "issue": "#207",
      "rationale": "Alternate access-group and unified access-control records require distinct identity and assignment ownership review."
    },
    {
      "disposition": "unsupported_durable",
      "id": "guardrail_management",
      "issue": "#207",
      "rationale": "Additional guardrail definitions and submission records are durable but not covered by the supported guardrail lifecycle."
    },
    {
      "disposition": "unsupported_durable",
      "id": "agent_prompt_tool_management",
      "issue": "#207",
      "rationale": "Alternate agent, prompt-info, and tool definition operations are durable surfaces outside current lifecycle ownership."
    },
    {
      "disposition": "unsupported_durable",
      "id": "workflow_memory_management",
      "issue": "#207",
      "rationale": "Workflow and memory records require separate stable identity, import, and retention semantics."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "inference_workload",
      "rationale": "Inference, pass-through forwarding, embeddings, media, MCP execution, and workload APIs execute requests rather than declare provider-owned configuration."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "operational_action",
      "rationale": "One-shot reset, migration, approval, cancellation, publication, and export actions have no durable Terraform identity."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "health",
      "rationale": "Health, readiness, connectivity, and runtime status probes report operational state rather than desired state."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "spend_analytics",
      "rationale": "Spend, usage, logs, audit, activity, and analytics routes expose observations or one-shot calculations rather than durable configuration."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "cache_flush",
      "rationale": "Cache deletion and flush routes are one-shot runtime actions with no durable identity."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "suggestion_discovery",
      "rationale": "Discovery, schema, comparison, resolution, marketplace, and suggestion routes return advisory or derived data."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "authentication_flow",
      "rationale": "OAuth, token, registration, callback, and well-known routes participate in runtime authentication protocols."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "testing_validation",
      "rationale": "Dry-run, validation, conversion, compliance-check, and test-connection routes perform transient checks."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "public_metadata",
      "rationale": "Public catalogs and available-object metadata are observational discovery surfaces."
    },
    {
      "disposition": "excluded_non_durable",
      "id": "audit_observability",
      "rationale": "Debug and control-plane log ingestion routes are runtime observability surfaces."
    }
  ],
